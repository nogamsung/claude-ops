GITHUB_TOKEN=ghp_your_personal_access_token_here
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
HTTP_BIND_ADDR=127.0.0.1:8787
CONFIG_PATH=config.example.yaml

# MySQL — required. parseTime=true and charset=utf8mb4 are mandatory; NewDB
# rejects DSNs missing them. loc=UTC keeps storage tz-stable; resolve display
# tz in the application layer.
MYSQL_DSN=claude_ops:change_me@tcp(127.0.0.1:3306)/claude_ops?parseTime=true&charset=utf8mb4&loc=UTC

# Used by deployments/docker-compose.yml only — bare-metal installs can ignore.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=claude_ops
MYSQL_USER=claude_ops
MYSQL_PASSWORD=change_me
